# انسخ الملف ده باسم .env وعدّل القيم
# cp .env.example .env

# توكن البوت من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=

# مسار قاعدة البيانات (الافتراضي results.db جنب الكود)
DB_PATH=results.db

# أرقام حسابات الأدمن على تليجرام، مفصولة بفاصلة (اعرف رقمك بأمر /id)
# لو سيبتها فاضية، أمر /stats هيبقى متاح للكل
ADMIN_IDS=

# المجموع الكلي — يُستخدم لحساب النسبة لو الملف مفيهوش عمود نسبة
TOTAL_MAX=320

# البحث بالاسم (true/false)
ENABLE_NAME_SEARCH=true
NAME_SEARCH_LIMIT=8

# حد الطلبات لكل مستخدم
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# إعدادات الموقع
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_TITLE=نتيجة الثانوية العامة
